# Resend (email service) API key - required for sending emails from the serverless function
RESEND_API_KEY=your_resend_api_key_here

# From address used when sending emails (optional - defaults to onboarding@resend.dev)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Business email where inquiries are sent (required)
RESEND_BUSINESS_EMAIL=business@example.com


# Frontend base URL used in some environments (example for local dev)
VITE_API_BASE_URL=http://localhost:5173

# NODE_ENV can be set to 'development' or 'production' (optional)
# NODE_ENV=development
